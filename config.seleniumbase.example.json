{
  "start_url": "http://prophub.test:8080/properties?page=1",
  "output_csv": "data/seleniumbase-listings.csv",
  "checkpoint_file": "data/seleniumbase-checkpoint.json",
  "allow_live_browser": false,
  "headless": false,
  "timeout_seconds": 15,
  "page_delay_seconds": 1,
  "max_pages": 10,
  "max_attempts_per_page": 3,
  "backoff_base_seconds": 5,
  "empty_page_stop_threshold": 3,
  "browser": {
    "uc": true,
    "cdp": true,
    "stealth_clicks": true,
    "reconnect_time_seconds": 4
  },
  "selectors": {
    "card": "[data-test='property-card']",
    "listing_id": {
      "selector": "[data-listing-id]",
      "attribute": "data-listing-id"
    },
    "address": {
      "selector": "address"
    },
    "price": {
      "selector": "[data-test='price']"
    },
    "url": {
      "selector": "a[data-test='details-link']",
      "attribute": "href"
    }
  },
  "dynamic_content": {
    "mode": "scroll",
    "max_rounds": 30,
    "stable_rounds": 2,
    "pause_seconds": 0.5
  },
  "pagination": {
    "mode": "next_button",
    "next_selector": "a[aria-label='Next page']",
    "disabled_attribute": "aria-disabled"
  },
  "challenge": {
    "mode": "seleniumbase",
    "marker_selector": "[data-test='challenge']",
    "allowed_hosts": [
      "prophub.test",
      "localhost"
    ],
    "seleniumbase_handler": "gui_handle_captcha",
    "frame_selector": "iframe",
    "retry": false,
    "blind": false,
    "completion_timeout_seconds": 30,
    "answer_selector": "[data-test='challenge-answer']",
    "submit_selector": "[data-test='challenge-submit']",
    "success_selector": "[data-test='property-results']",
    "answer_env": "PROPHUB_TEST_CHALLENGE_ANSWER",
    "manual_timeout_seconds": 120
  }
}
