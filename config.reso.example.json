{
  "service_root": "https://YOUR-PROVIDER.example/reso/odata",
  "resource": "Property",
  "source_name": "Your authorized RESO provider",
  "coverage_scope": "Active residential sale and lease listings in Toronto permitted by the provider agreement",
  "license": {
    "name": "Your provider data agreement",
    "url": "https://YOUR-PROVIDER.example/data-terms"
  },
  "output_csv": "data/reso-listings.csv",
  "checkpoint_file": "data/reso-checkpoint.json",
  "metadata_file": "data/reso-metadata.json",
  "filter": "City eq 'Toronto' and StandardStatus eq 'Active'",
  "select": [
    "ListingKey",
    "ListingId",
    "UnparsedAddress",
    "StreetNumber",
    "StreetDirPrefix",
    "StreetName",
    "StreetSuffix",
    "UnitNumber",
    "City",
    "StateOrProvince",
    "PostalCode",
    "ListPrice",
    "BedroomsTotal",
    "BathroomsTotalInteger",
    "BathroomsTotalDecimal",
    "LivingArea",
    "ListAgentFullName",
    "ListOfficeName",
    "ListingURL",
    "VirtualTourURLUnbranded",
    "StandardStatus",
    "PropertyType",
    "ModificationTimestamp"
  ],
  "field_map": {
    "listing_id": ["ListingKey", "ListingId"],
    "address": ["UnparsedAddress"],
    "price": ["ListPrice"],
    "beds": ["BedroomsTotal"],
    "baths": ["BathroomsTotalInteger", "BathroomsTotalDecimal"],
    "sqft": ["LivingArea"],
    "agent": ["ListAgentFullName", "ListOfficeName"],
    "url": ["ListingURL", "VirtualTourURLUnbranded"]
  },
  "page_size": 500,
  "max_pages": 0,
  "pagination_mode": "auto",
  "timeout_seconds": 30,
  "max_attempts_per_request": 3,
  "backoff_base_seconds": 2,
  "auth": {
    "mode": "client_credentials",
    "token_url": "https://YOUR-PROVIDER.example/oauth/token",
    "client_id_env": "RESO_CLIENT_ID",
    "client_secret_env": "RESO_CLIENT_SECRET",
    "scope": ""
  }
}
